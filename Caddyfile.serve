# Internal Caddy config for the FE container.
# Serves the built React SPA with:
#   - try_files fallback to index.html (client-side routing)
#   - gzip compression
:80 {
	root * /srv
	encode gzip

	# Force no-cache for all HTML and entry points
	@html {
		path *.html / /index.html
	}
	header @html Cache-Control "no-cache, no-store, must-revalidate"
	header @html Pragma "no-cache"
	header @html Expires "0"

	# Cache hashed assets for a long time (1 year)
	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	# Client-side routing: fallback to index.html ONLY for non-asset paths
	handle /assets/* {
		file_server
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}

